    "m_SourceType": 1,
    "m_FunctionName": "ComputeSlopeFoam",
    "m_FunctionSource": "",
    "m_FunctionBody": "half normalDotUp = saturate(1 - NormalWS.y * NormalWS.y);\r\nhalf slopeFade = 1 - frac((PositionWS.y + PoseidonTime * SlopeFoamFlowSpeed) / SlopeFoamDistance);\r\nhalf midPoint = 0.9;\r\nslopeFade = (slopeFade < midPoint) * (slopeFade / midPoint) + (slopeFade >= midPoint) * (lerp(1, 0, (slopeFade-midPoint)/(1-midPoint)));\r\nslopeFade *= SlopeFoamStrength;\r\nslopeFade -= FoamNoiseWS;\r\nslopeFade *= (normalDotUp);\r\nslopeFade = pow(saturate(slopeFade), 2);\nhalf slopeClip = slopeFade >= 0.1;\r\n\nColorSharp = FoamColor * slopeClip;\r\nColorFade = FoamColor*slopeFade;"
}

